{
  "expo": {
    "name": "autotk",
    "slug": "autotk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": false,
      "url": "https://updates.你的域名.com/api/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ddowl.autotk",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "用于后台保活，保持自动化在后台持续运行",
        "NSLocationWhenInUseUsageDescription": "用于后台保活，保持自动化在后台持续运行",
        "NSLocalNetworkUsageDescription": "用于在同一 WiFi 下发现并连接电脑端控制中心、接收要发布的视频",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "用于扫码连接电脑端控制中心"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "用于把要发布的视频存入相册后再发布",
          "savePhotosPermission": "用于把要发布的视频存入相册后再发布",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
