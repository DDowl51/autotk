# autotk 手机端构建期配置 —— 复制为 .env（.env 已被 gitignore，不进仓库）。
# EXPO_PUBLIC_* 会在打包/OTA 导出时【内联进 JS】。改了这些值必须重新出包或 OTA 推送。
# 出正式包前跑 `npm run check:release` 校验（占位符/漏填会中止构建）。

# 激活服务器地址（本产品固定域名，HTTPS）。迁移换地址走 src/license/override.ts + OTA。
EXPO_PUBLIC_LICENSE_URL=https://license.ddowl.tech

# 产品 key / secret：在 license 管理后台「产品」页建 autotk 产品时拿到（secret 只显示一次）。
EXPO_PUBLIC_LICENSE_PRODUCT_KEY=FILL_PRODUCT_KEY
EXPO_PUBLIC_LICENSE_PRODUCT_SECRET=FILL_PRODUCT_SECRET

# 管理中心 Hub 地址（如接入云 Hub 才需要；不设走本地/局域网默认）。
# EXPO_PUBLIC_HUB_URL=https://hub.你的域名.com
