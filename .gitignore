# ---- dependencies / build output ----
node_modules/
dist/
build/
.expo/
tools/dist/
*.tsbuildinfo

# ---- native (RN/Expo) ----
# 锚定到仓库根，避免误伤 apps/mobile/modules/*/ios|android/ 的原生模块源码（必须入库）。
# apps/mobile 生成的 ios/ android/ 由 apps/mobile/.gitignore 忽略。
/ios/
/android/

# ---- env / local config ----
.env
.env.*
*.log
# signing-station real config carries credential paths; only the example is tracked
config.json

# ---- secrets / signing material (NEVER commit) ----
**/secrets/
data/
*.p8
*.p12
*.cer
*.key
*.mobileprovision
*.ipa

# ---- large media / binaries (tutorials & tools, not source) ----
*.mp4
*.exe
*.ips
*.docx
*.PNG
*.pdf

# ---- runtime data / dev leftovers (contain real device IDs; never commit / never ship) ----
hub-data/
apps/mobile/chi_sim.traineddata
apps/mobile/adaptation/screenshots/

# ---- OTA update-server: code-signing private key + published update payloads (never commit) ----
apps/mobile/code-signing/*private*
apps/mobile/code-signing/*.key
services/update-server/data/
services/update-server/updates/
